# Copier en .env (jamais commité) ou exporter dans le shell.
ANTHROPIC_API_KEY=
# Modèle utilisé pour le plan de mix
PROMPTMIX_MODEL=claude-opus-5-5
# auto | beat_this | dsp
PROMPTMIX_BEAT_ENGINE=auto
# Dossier de travail (fichiers déposés, rendus) - purgé 24 h après le rendu
PROMPTMIX_DATA_DIR=./data

# --- Crédits et paiement (laisser off en développement : tout est gratuit, sans compte)
PROMPTMIX_BILLING=off
# Adresse publique de l'appli (retour après paiement)
PROMPTMIX_PUBLIC_URL=https://app.exemple.fr
# Clés Stripe (tableau de bord Stripe > Développeurs). Commencer par les clés de TEST (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Crédits offerts à l'inscription
PROMPTMIX_WELCOME_CREDITS=1
# Packs (facultatif, sinon ceux de config.py) :
# PROMPTMIX_PACKS=[{"id":"pack5","name":"Pack 5 mix","credits":5,"price_cents":699}]
