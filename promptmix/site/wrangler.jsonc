// Configuration Cloudflare (Workers) du site vitrine PromptMix.
// Dans Cloudflare : Settings → Build → Root directory = promptmix/site
// Seul le dossier public/ est mis en ligne.
{
  "name": "promptmix",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
