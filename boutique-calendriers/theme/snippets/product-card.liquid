{%- comment -%}
  Carte produit.
  - product: objet produit (vide = carte d'exemple)
  - placeholder_index: numéro de l'image d'exemple (1 à 6)
  - show_vendor, quick_add: booléens
  - sizes: attribut sizes des images
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 1100px) 300px, (min-width: 750px) 33vw, 50vw'
-%}
<article class="card">
  {%- if product != blank -%}
    {%- assign image_alt = product.featured_media.alt | default: product.title | escape -%}
    <a href="{{ product.url }}" class="card__media" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: sizes,
            alt: image_alt
        }}
        {%- if product.media.size > 1 -%}
          {{
            product.media[1]
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: sizes,
              class: 'card__img-2',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <span class="badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price_min > product.price_min -%}
          {%- assign saving = product.compare_at_price_min | minus: product.price_min | times: 100 | divided_by: product.compare_at_price_min | round -%}
          <span class="badge">-{{ saving }}%</span>
        {%- endif -%}
        {%- if product.tags contains 'nouveau' -%}
          <span class="badge badge--gold">{{ 'products.product.new' | t }}</span>
        {%- endif -%}
      </span>
    </a>
    <div class="card__body">
      {%- if show_vendor and product.vendor != blank -%}
        <span class="card__vendor">{{ product.vendor }}</span>
      {%- endif -%}
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {% render 'price', product: product %}
      {%- if quick_add -%}
        <div class="card__actions">
          {%- if product.available and product.has_only_default_variant -%}
            {%- form 'product', product, data-add-to-cart: '' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn--outline btn--small">
                {%- render 'icon', name: 'plus' -%}
                {{ 'products.product.quick_add' | t }}
              </button>
            {%- endform -%}
          {%- elsif product.available -%}
            <a href="{{ product.url }}" class="btn btn--outline btn--small">{{ 'products.product.choose_options' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- assign placeholder = 'product-' | append: placeholder_index -%}
    <div class="card__media">
      {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="card__body">
      <h3 class="card__title">{{ 'products.product.placeholder_title' | t }}</h3>
      <div class="price"><span>{{ 2990 | money }}</span></div>
    </div>
  {%- endif -%}
</article>
