<div class="password">
  <div class="password__box">
    {% render 'advent-grid', ribbon: section.settings.ribbon, teaser: true %}
    <p class="eyebrow">{{ shop.name }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
      <input class="input" id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}">
      <button type="submit" class="btn btn--accent">{{ 'password.notify' | t }}</button>
      {%- if form.posted_successfully? -%}
        <p class="notice notice--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <details>
      <summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
        <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
        <button type="submit" class="btn">{{ 'password.enter' | t }}</button>
        {%- if form.errors -%}
          <p class="notice notice--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

<script>
  document.querySelectorAll('.password details').forEach(function (details) {
    if (details.querySelector('.notice--error')) details.open = true;
  });
</script>

{% schema %}
{
  "name": "Page d'attente",
  "class": "section-main-password",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Les calendriers arrivent <em>bientôt</em>"
    },
    {
      "type": "text",
      "id": "ribbon",
      "label": "Ruban",
      "default": "Bientôt"
    }
  ]
}
{% endschema %}
