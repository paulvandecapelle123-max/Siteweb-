{%- liquid
  assign per_page = section.settings.per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign show_filters = false
  if section.settings.show_filters and collection.filters.size > 0
    assign show_filters = true
  endif
-%}
<div class="collection-hero container">
  <h1>{{ collection.title | escape }}</h1>
  {%- if collection.description != blank -%}
    <div class="rte">{{ collection.description }}</div>
  {%- endif -%}
</div>

<div class="container section" style="padding-top: 0;">
  {%- paginate collection.products by per_page -%}
    <div class="toolbar">
      <span class="toolbar__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
      <div class="toolbar__right">
        {%- if show_filters -%}
          <button
            type="button"
            class="btn btn--outline btn--small filters-toggle"
            data-filters-toggle
            aria-controls="Filters-{{ section.id }}"
            aria-expanded="false"
          >
            {{ 'collections.filters' | t }}
          </button>
        {%- endif -%}
        <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
        <select class="select" id="SortBy-{{ section.id }}" data-sort-select>
          {%- for option in collection.sort_options -%}
            <option
              value="{{ option.value | escape }}"
              {% if option.value == sort_by %}
                selected
              {% endif %}
            >
              {{ option.name | escape }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="collection-layout{% if show_filters %} collection-layout--filters{% endif %}">
      {%- if show_filters -%}
        <aside class="filters" id="Filters-{{ section.id }}">
          <form action="{{ collection.url }}" method="get" data-filter-form>
            <input type="hidden" name="sort_by" value="{{ sort_by }}">
            {%- for filter in collection.filters -%}
              <details class="filter" open>
                <summary>{{ filter.label | escape }}{% render 'icon', name: 'chevron-down' %}</summary>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="filter__price">
                      <input
                        class="input"
                        type="number"
                        name="{{ filter.min_value.param_name }}"
                        {% if filter.min_value.value %}
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}"
                        {% endif %}
                        placeholder="0"
                        min="0"
                        aria-label="{{ 'collections.price_from' | t }}"
                      >
                      <input
                        class="input"
                        type="number"
                        name="{{ filter.max_value.param_name }}"
                        {% if filter.max_value.value %}
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}"
                        {% endif %}
                        placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                        min="0"
                        aria-label="{{ 'collections.price_to' | t }}"
                      >
                    </div>
                    <button type="submit" class="btn btn--small btn--outline">{{ 'collections.apply' | t }}</button>
                  {%- else -%}
                    <ul>
                      {%- for value in filter.values -%}
                        <li>
                          <label class="{% if value.count == 0 and value.active == false %}is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >
                            {{ value.label | escape }}
                            <span class="filter__count">({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </details>
            {%- endfor -%}
          </form>
        </aside>
      {%- endif -%}

      <div>
        {%- liquid
          assign active_count = 0
          for filter in collection.filters
            assign active_count = active_count | plus: filter.active_values.size
            if filter.type == 'price_range'
              if filter.min_value.value != null or filter.max_value.value != null
                assign active_count = active_count | plus: 1
              endif
            endif
          endfor
        -%}
        {%- if active_count > 0 -%}
          <div class="active-filters">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <a class="chip" href="{{ value.url_to_remove }}">{{ value.label | escape }}{% render 'icon', name: 'close' %}</a>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                  <a class="chip" href="{{ filter.url_to_remove }}">
                    {{- filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money -}}
                    {%- render 'icon', name: 'close' -%}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <a class="chip" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear_all' | t }}</a>
          </div>
        {%- endif -%}

        {%- if collection.products.size > 0 -%}
          <ul class="grid {% if show_filters %}grid--3{% else %}grid--4{% endif %}">
            {%- for product in collection.products -%}
              <li class="reveal">
                {% render 'product-card', product: product, quick_add: section.settings.quick_add %}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="empty">
            <div class="empty__icon">{% render 'icon', name: 'gift' %}</div>
            <h2 class="h3">{{ 'collections.empty' | t }}</h2>
            <p>{{ 'collections.empty_text' | t }}</p>
            <a href="{{ collection.url }}" class="btn">{{ 'collections.clear_all' | t }}</a>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Afficher les filtres",
      "info": "Les filtres se règlent avec l'application gratuite Search & Discovery de Shopify.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Bouton d'ajout rapide",
      "default": true
    }
  ]
}
{% endschema %}
