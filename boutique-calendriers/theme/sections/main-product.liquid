{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
-%}
<section class="container" data-product data-update-url>
  <script type="application/json" data-product-json>
    { "variants": {{ product.variants | json }} }
  </script>

  <div class="product">
    <div class="product__media">
      <div class="gallery">
        <div class="gallery__track" data-gallery-track>
          {%- for media in product.media -%}
            <div class="gallery__slide" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1100x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                    assign media_alt = media.alt | default: product.title | escape
                  -%}
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: loading,
                      widths: '450, 700, 1000, 1400',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: media_alt
                  }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery__slide">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endfor -%}
        </div>
        {%- if media_count > 1 -%}
          <button type="button" class="gallery__nav gallery__nav--prev" data-gallery-prev aria-label="{{ 'products.product.media_previous' | t }}">
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <button type="button" class="gallery__nav gallery__nav--next" data-gallery-next aria-label="{{ 'products.product.media_next' | t }}">
            {% render 'icon', name: 'chevron-right' %}
          </button>
          <span class="gallery__count" data-gallery-count>1 / {{ media_count }}</span>
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        <ul class="gallery__thumbs">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="gallery__thumb"
                data-gallery-thumb
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media_show' | t: index: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'breadcrumbs' -%}
            <nav aria-label="{{ 'general.breadcrumbs' | t }}" {{ block.shopify_attributes }}>
              <ol class="breadcrumbs">
                <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
                {%- if collection -%}
                  <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
                {%- else -%}
                  <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.all_products' | t }}</a></li>
                {%- endif -%}
                <li aria-current="page">{{ product.title | escape }}</li>
              </ol>
            </nav>

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              <h1 class="product__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'text' -%}
            <div class="rte product__subtitle" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="product__price-row">
                {% render 'price', product: product, variant: current_variant, show_badge: true, class: 'price--large' %}
              </div>
              {%- if cart.taxes_included or shop.taxes_included -%}
                <p class="product__tax">{{ 'products.product.taxes_included' | t }}</p>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="option" data-option>
                    <legend>
                      {{ option.name | escape }} :
                      <span data-option-value>{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="option__values">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign value_label = value.name | default: value
                          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
                        -%}
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ section.id }}-{{ option.position }}"
                          value="{{ value_label | escape }}"
                          {% if option.selected_value == value_label %}
                            checked
                          {% endif %}
                        >
                        <label for="{{ input_id }}">{{ value_label | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-add-to-cart: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="buy">
                  <div class="qty">
                    <button type="button" data-qty-step="-1" aria-label="{{ 'products.product.quantity_decrease' | t }}">
                      {% render 'icon', name: 'minus' %}
                    </button>
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="{{ 'products.product.quantity_increase' | t }}">
                      {% render 'icon', name: 'plus' %}
                    </button>
                  </div>
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--accent btn--block"
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span data-submit-label>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                </div>
                <p class="notice notice--error form-error" data-form-error role="alert"></p>
              {%- endform -%}
            </div>

          {%- when 'delivery' -%}
            {%- if settings.show_delivery_estimate -%}
              <div {{ block.shopify_attributes }}>
                {% render 'delivery-estimate', product: product %}
              </div>
            {%- endif -%}

          {%- when 'trust' -%}
            <ul class="trust" {{ block.shopify_attributes }}>
              {%- if block.settings.line_1 != blank -%}
                <li>{% render 'icon', name: 'lock' %}{{ block.settings.line_1 | escape }}</li>
              {%- endif -%}
              {%- if block.settings.line_2 != blank -%}
                <li>{% render 'icon', name: 'package' %}{{ block.settings.line_2 | escape }}</li>
              {%- endif -%}
              {%- if block.settings.line_3 != blank -%}
                <li>{% render 'icon', name: 'return' %}{{ block.settings.line_3 | escape }}</li>
              {%- endif -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details {% if block.settings.open %}open{% endif %}>
                  <summary>
                    <span class="accordion__title">{% render 'icon', name: 'gift' %}{{ 'products.product.description' | t }}</span>
                    {% render 'icon', name: 'plus' %}
                  </summary>
                  <div class="accordion__content rte">{{ product.description }}</div>
                </details>
              </div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details>
                <summary>
                  <span class="accordion__title">{% render 'icon', name: block.settings.icon %}{{ block.settings.heading | escape }}</span>
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy>
    <div class="sticky-buy__info">
      <div class="sticky-buy__title">{{ product.title | escape }}</div>
      <strong data-sticky-price>{{ current_variant.price | money }}</strong>
    </div>
    <button
      type="button"
      class="btn btn--accent btn--small"
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      {%- if current_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "class": "section-main-product",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "breadcrumbs",
      "name": "Fil d'Ariane",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Titre",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>24 surprises à découvrir du 1er au 24 décembre.</p>"
        }
      ]
    },
    {
      "type": "price",
      "name": "Prix",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Choix des variantes",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Boutons d'achat",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Boutons de paiement express (Apple Pay, Google Pay…)",
          "default": true
        }
      ]
    },
    {
      "type": "delivery",
      "name": "Livraison estimée",
      "limit": 1
    },
    {
      "type": "trust",
      "name": "Réassurance",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "line_1",
          "label": "Ligne 1 (cadenas)",
          "default": "Paiement 100 % sécurisé"
        },
        {
          "type": "text",
          "id": "line_2",
          "label": "Ligne 2 (colis)",
          "default": "Expédié avec numéro de suivi"
        },
        {
          "type": "text",
          "id": "line_3",
          "label": "Ligne 3 (retour)",
          "default": "14 jours pour changer d'avis"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open",
          "label": "Ouverte par défaut",
          "default": true
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Onglet repliable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Livraison"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Camion" },
            { "value": "return", "label": "Retour" },
            { "value": "package", "label": "Colis" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "star", "label": "Étoile" },
            { "value": "chat", "label": "Message" }
          ],
          "default": "truck"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenu"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Ou contenu d'une page"
        }
      ]
    }
  ]
}
{% endschema %}
